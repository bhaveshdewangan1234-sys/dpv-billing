rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero Access for unauthenticated public clients
    // Only authenticated studio staff/admin can read or write
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStudioStaff() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'staff' || request.auth.token.email != null);
    }

    // Isolated DPV Invoice Collections namespace
    match /dpv_inv_{collectionName}/{document=**} {
      allow read, write: if isStudioStaff();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
